# The deployed backend's API URL, including the /api path.
# Leave unset for local development — defaults to
# http://localhost:5000/api (see src/services/api.js), matching the
# backend's local PORT.
#
# On Vercel: set this in Project Settings -> Environment Variables.
# It must be set at BUILD time, not just runtime — Vite inlines
# import.meta.env.* values into the built JS during `vite build`,
# so a value added after the build won't take effect until the next
# deploy/rebuild.
VITE_API_URL=https://your-backend.onrender.com/api
