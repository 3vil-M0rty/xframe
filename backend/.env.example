# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-secret-key-change-this

# Server
PORT=5000
NODE_ENV=development

# CORS — the deployed frontend's URL(s). Comma-separated if you
# need more than one (e.g. production + a Vercel preview
# deployment). Leave unset for local development (defaults to the
# Vite dev server on localhost:5173).
CORS_ORIGINS=https://your-app.vercel.app
# Single-URL alternative to CORS_ORIGINS above — kept for backward
# compatibility. If both are set, CORS_ORIGINS wins.
FRONTEND_URL=

# ------------------------------------------------------------
# USER-GENERATED CONTENT TRANSLATION (fr / en / ar)
# ------------------------------------------------------------
# Which content language a newly-detected/untagged piece of text
# falls back to. Must be one of fr, en, ar.
# Which content languages to translate into — should match the
# frontend's SUPPORTED_LANGUAGES (src/config/i18n.config.js) exactly.
# Comma-separated, no spaces needed. Leave unset to use the default
# below (the 6 languages the frontend ships with today).
CONTENT_LANGUAGES=en,fr,ar,es,pt,de

DEFAULT_CONTENT_LANGUAGE=fr

# Which translation API to use for auto-translating product names,
# job titles, descriptions, notes, etc. One of: google, libretranslate,
# deepl. Leave unset to run without auto-translation (translations
# can still be entered manually from the UI; nothing else breaks).
TRANSLATION_PROVIDER=

# --- google (Google Cloud Translation API v2) ---
GOOGLE_TRANSLATE_API_KEY=

# --- libretranslate (self-hosted or hosted instance) ---
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# --- deepl ---
DEEPL_API_KEY=
# Optional override; auto-picked from the key format (":fx" suffix = free tier) otherwise.
DEEPL_API_HOST=

# Per-call timeout / retry tuning (optional, sensible defaults apply)
TRANSLATION_TIMEOUT_MS=8000
TRANSLATION_MAX_RETRIES=2
